{
  "name": "ravenleemills-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "node tests/e2e/serve.mjs",
    "typecheck": "nuxt typecheck",
    "assets": "node scripts/render-assets.mjs",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "nuxt generate && playwright test --config tests/e2e/playwright.config.ts",
    "ramps:check": "python3 scripts/ramps.py --check",
    "ramps:contrast": "python3 scripts/ramps.py --contrast",
    "tile:check": "node scripts/tile-geometry.mjs --check",
    "i18n:check": "node scripts/i18n-check.mjs",
    "favicon": "node scripts/favicon.mjs",
    "check": "pnpm ramps:check && pnpm tile:check && pnpm i18n:check"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.146",
    "@iconify-json/simple-icons": "1.2.100",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "marked": "18.1.1",
    "nuxt": "4.6.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  }
}
